# ── OpenAI (for CrewAI trade analysis) ───────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Nubra SDK credentials ─────────────────────────────────────────────────────
# Required for OHLCV market data fetching.
# Run `make login` once to authenticate and cache the session.
PHONE_NO=9999999999
MPIN=1234

# Optional — only needed for TOTP (non-interactive) login.
# Get this by running `python scripts/nubra_setup_totp.py` after first OTP login.
# TOTP_SECRET=BASE32SECRETHERE

# ── MongoDB cache/persistence ────────────────────────────────────────────────
MONGO_URI=mongodb://root:rootpass@localhost:27017/?authSource=admin
MONGO_DB_NAME=trade_journal

# ── External backend monitor ────────────────────────────────────────────────
BACKEND_HEALTH_URL=http://localhost:8000/health
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
MONITOR_INTERVAL_SECONDS=30
MONITOR_TIMEOUT_SECONDS=5
MONITOR_PORT=8001
